@model List<Pedido>
@{
    ViewData["Title"] = "Pedidos";
    StatusPedido? statusSelecionado = ViewBag.StatusSelecionado;
}

<h1 class="mb-4">Pedidos</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<StatusPedido>()" onchange="this.form.submit()">
            <option value="">Todos os status</option>
        </select>
    </div>
</form>

<table class="table align-middle">
    <thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Status</th><th>Total</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>#@p.Id</td>
                <td>@p.Cliente?.NomeCompleto</td>
                <td>@p.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="badge bg-secondary">@p.Status.GetDisplayName()</span></td>
                <td>R$ @p.ValorTotal.ToString("F2")</td>
                <td><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Gerenciar</a></td>
            </tr>
        }
    </tbody>
</table>
