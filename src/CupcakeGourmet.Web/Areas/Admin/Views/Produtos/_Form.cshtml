@model Produto
@using Microsoft.AspNetCore.Mvc.Rendering

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Nome" class="form-label"></label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descricao" class="form-label"></label>
    <textarea asp-for="Descricao" class="form-control"></textarea>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Preco" class="form-label"></label>
        <input asp-for="Preco" class="form-control" />
        <span asp-validation-for="Preco" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="QuantidadeEmEstoque" class="form-label"></label>
        <input asp-for="QuantidadeEmEstoque" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" class="form-select" asp-items="(SelectList)ViewBag.Categorias"></select>
    </div>
</div>
<div class="mb-3">
    <label asp-for="ImagemUrl" class="form-label"></label>
    <input asp-for="ImagemUrl" class="form-control" placeholder="https://..." />
</div>
<div class="form-check mb-3">
    <input asp-for="Ativo" class="form-check-input" />
    <label asp-for="Ativo" class="form-check-label"></label>
</div>

<button type="submit" class="btn btn-danger">Salvar</button>
<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
