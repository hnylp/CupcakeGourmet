@using CupcakeGourmet.Web.Models
@model List<Pedido>
@{
    ViewData["Title"] = "Meus Pedidos";
}

<h1 class="mb-4">Meus Pedidos</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Você ainda não fez nenhum pedido. <a asp-controller="Produtos" asp-action="Index">Ver catálogo</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model)
                {
                    <tr>
                        <td>#@pedido.Id</td>
                        <td>@pedido.DataPedido.ParaHorarioBrasilia().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge bg-secondary">@pedido.Status.GetDisplayName()</span></td>
                        <td>R$ @pedido.ValorTotal.ToString("F2")</td>
                        <td><a asp-action="Details" asp-route-id="@pedido.Id" class="btn btn-sm btn-outline-danger">Acompanhar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
