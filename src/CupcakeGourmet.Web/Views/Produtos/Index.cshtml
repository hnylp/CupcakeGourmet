@using CupcakeGourmet.Web.Models
@model List<Produto>
@{
    ViewData["Title"] = "Catálogo";
    var categorias = ViewBag.Categorias as List<Categoria> ?? new List<Categoria>();
    int? categoriaSelecionada = ViewBag.CategoriaSelecionada;
    string? busca = ViewBag.Busca;
}

<h1 class="mb-4">Catálogo de Cupcakes</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="busca" value="@busca" class="form-control" placeholder="Buscar por nome..." />
    </div>
    <div class="col-md-4">
        @{
            var listaCategorias = new SelectList(categorias, "Id", "Nome", categoriaSelecionada);
        }
        <select name="categoriaId" class="form-select" asp-items="listaCategorias">
            <option value="">Todas as categorias</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-danger w-100">Filtrar</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    @foreach (var produto in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(produto.ImagemUrl ?? "https://via.placeholder.com/400x250?text=Cupcake")" class="card-img-top" alt="@produto.Nome" style="height:200px;object-fit:cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@produto.Nome</h5>
                    <p class="card-text text-muted small">@produto.Categoria?.Nome</p>
                    <p class="card-text">@produto.Descricao</p>
                    <p class="card-text fw-bold text-danger fs-5">R$ @produto.Preco.ToString("F2")</p>
                    <div class="d-flex gap-2 mt-auto">
                        <a class="btn btn-outline-secondary flex-fill" asp-action="Details" asp-route-id="@produto.Id">Detalhes</a>
                        <form asp-controller="Carrinho" asp-action="Adicionar" method="post" class="flex-fill">
                            <input type="hidden" name="produtoId" value="@produto.Id" />
                            <input type="hidden" name="quantidade" value="1" />
                            <button type="submit" class="btn btn-danger w-100">Adicionar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Nenhum produto encontrado com esses filtros.</div>
}
