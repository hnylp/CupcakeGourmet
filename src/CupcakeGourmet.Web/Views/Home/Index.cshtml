@model List<CupcakeGourmet.Web.Models.Produto>
@{
    ViewData["Title"] = "Início";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">🧁 Cupcake Gourmet</h1>
    <p class="fs-5 col-md-8 mx-auto">
        Cupcakes artesanais feitos com ingredientes selecionados, entregues fresquinhos na sua casa.
    </p>
    <a class="btn btn-danger btn-lg" asp-controller="Produtos" asp-action="Index">Ver catálogo completo</a>
</div>

<h2 class="mb-3">Novidades</h2>
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    @foreach (var produto in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(produto.ImagemUrl ?? "https://via.placeholder.com/400x250?text=Cupcake")" class="card-img-top" alt="@produto.Nome" style="height:200px;object-fit:cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@produto.Nome</h5>
                    <p class="card-text text-muted small">@produto.Categoria?.Nome</p>
                    <p class="card-text fw-bold text-danger">R$ @produto.Preco.ToString("F2")</p>
                    <a class="btn btn-outline-danger mt-auto" asp-controller="Produtos" asp-action="Details" asp-route-id="@produto.Id">Ver detalhes</a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Nenhum produto cadastrado ainda.</p>
}
