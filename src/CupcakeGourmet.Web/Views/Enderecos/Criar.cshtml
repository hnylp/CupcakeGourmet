@using CupcakeGourmet.Web.Models
@model Endereco
@{
    ViewData["Title"] = "Novo Endereço";
    string? returnUrl = ViewBag.ReturnUrl;
}

<h1 class="mb-4">Novo Endereço</h1>

<form asp-action="Criar" method="post" class="row g-3">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Apelido" class="form-label"></label>
        <input asp-for="Apelido" class="form-control" placeholder="Ex.: Casa, Trabalho" />
        <span asp-validation-for="Apelido" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Cep" class="form-label"></label>
        <input asp-for="Cep" class="form-control" placeholder="00000-000" />
        <span asp-validation-for="Cep" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Logradouro" class="form-label"></label>
        <input asp-for="Logradouro" class="form-control" />
        <span asp-validation-for="Logradouro" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Numero" class="form-label"></label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Complemento" class="form-label"></label>
        <input asp-for="Complemento" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Bairro" class="form-label"></label>
        <input asp-for="Bairro" class="form-control" />
        <span asp-validation-for="Bairro" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Cidade" class="form-label"></label>
        <input asp-for="Cidade" class="form-control" />
        <span asp-validation-for="Cidade" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Uf" class="form-label"></label>
        <input asp-for="Uf" class="form-control" maxlength="2" placeholder="SP" />
        <span asp-validation-for="Uf" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-danger">Salvar endereço</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
